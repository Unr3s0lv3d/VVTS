(*
 * WPAD test state machine
 * Brengt een access point op met DHCP optie 252 (WPAD).
 * Clients die verbinden krijgen automatisch de proxy-URL via DHCP.
 *
 * Pas aan voordat je dit gebruikt:
 *   - ap.dhcp4_wpad_proxy  : adres van je proxy server (host:port)
 *   - ap.dhcp4_wpad_direct : hosts die NIET via de proxy gaan (gescheiden door ;)
 *                            ondersteunt wildcards, bijv. *.example.com
 *)

state init begin:
  miscnet = miscnet();
  miscnet.masquerade("true");

  ap = accesspoint();
  ap.wifi_interface = "wlan0";
  ap.ipv4_addr = "192.168.60.1";
  ap.ipv4_netmask = "255.255.255.0";
  ap.dhcp4_enable = "true";
  ap.dhcp4_dns = "192.168.60.1";
  ap.dhcp4_router = "192.168.60.1";
  (* proxy adres dat in het PAC bestand komt *)
  ap.dhcp4_wpad_proxy = "192.168.60.1:8080";
  (* hosts die direct verbinden, niet via de proxy *)
  ap.dhcp4_wpad_direct = "192.168.60.1;*.local";
  ap.bring_up(ap_up, ap_err);

state ap_err:
  exit("Access point kon niet worden opgestart: ", errstr);

state ap_up:
  print("Access point is actief.");
  print("WPAD server draait op http://192.168.60.1/wpad.dat");
  print("Druk Ctrl+C om te stoppen.");
