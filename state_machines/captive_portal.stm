(*
 * Captive portal state machine
 * Brengt een access point op met een captive portal.
 * Clients die verbinden worden onderschept en naar de portal pagina gestuurd.
 * Na accepteren krijgen ze toegang tot het internet.
 *
 * Twee modi:
 *   dns_detect : alleen OS-detectie domeinen worden omgeleid (Windows, Android, Apple, Linux)
 *                de client OS detecteert automatisch de portal en opent een browservenster
 *   dns_all    : alle DNS queries worden omgeleid naar de portal
 *                na autorisatie krijgt de client normale DNS toegang
 *
 * Pas aan voordat je dit gebruikt:
 *   - ap.captive_portal_mode      : "dns_detect" of "dns_all"
 *   - ap.captive_portal_page      : pad naar eigen HTML pagina (optioneel)
 *   - ap.captive_portal_redirect  : URL waar client naartoe gaat na accepteren
 *)

state init begin:
  miscnet = miscnet();
  miscnet.masquerade("true");

  ap = accesspoint();
  ap.wifi_interface = "wlan0";
  ap.ipv4_addr = "192.168.60.1";
  ap.ipv4_netmask = "255.255.255.0";
  ap.dhcp4_enable = "true";
  ap.dhcp4_dns = "192.168.60.1";
  ap.dhcp4_router = "192.168.60.1";
  ap.dns_enable = "true";
  ap.captive_portal_mode = "dns_detect";
  ap.captive_portal_page = "/etc/vvts/portal.html";
  ap.captive_portal_redirect = "http://example.com";
  ap.bring_up(ap_up, ap_err);

state ap_err:
  exit("Access point kon niet worden opgestart: ", errstr);

state ap_up:
  print("Access point is actief.");
  print("Captive portal draait op http://192.168.60.1");
  print("Druk Ctrl+C om te stoppen.");

state client_authorized:
  print("Client heeft de portal geaccepteerd: ", authorized_ip);
