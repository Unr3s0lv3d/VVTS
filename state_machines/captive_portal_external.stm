(*
 * Captive portal state machine met externe URL
 *
 * Test wat er gebeurt als de captive portal (DHCP optie 114) wijst naar
 * een publiek/extern IP of URL in plaats van een lokale server.
 *
 * De client ontvangt via DHCP optie 114 de externe URL. dns_detect zorgt
 * dat het OS de captive portal automatisch detecteert en de externe URL
 * opent. OS-detectieverkeer wordt lokaal onderschept en doorgestuurd naar
 * de externe URL.
 *
 * Let op: gebruik GEEN dns_all, dat onderschept alle DNS en stuurt de
 * client naar het lokale IP in plaats van de externe URL.
*)

state init begin:
  miscnet = miscnet();
  miscnet.masquerade("true");

  ap = accesspoint();
  ap.wifi_interface = "wlan0";
  ap.ipv4_addr = "192.168.60.1";
  ap.ipv4_netmask = "255.255.255.0";
  ap.dhcp4_enable = "true";
  ap.dhcp4_dns = "192.168.60.1";
  ap.dhcp4_router = "192.168.60.1";
  ap.dns_enable = "true";
  ap.captive_portal_mode = "dns_detect";


  ap.dhcp4_captive_portal_uri = "http://172.239.238.27/";

  ap.bring_up(ap_up, ap_err);

state ap_err:
  exit("Access point kon niet worden opgestart: ", errstr);

state ap_up:
  print("Access point is actief.");
  print("Druk Ctrl+C om te stoppen.");
